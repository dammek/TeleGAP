# ==============================================================================
# Telegram Mini App Configuration
# ==============================================================================

# TELEGRAM_BOT_TOKEN: The Bot API token obtained from @BotFather
# Used for HMAC-SHA256 initData validation and sending push notifications (Telegram Bot Notification Engine)
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"

# TELEGRAM_BOT_USERNAME: The Telegram bot username (e.g. Tel_alum_bot)
TELEGRAM_BOT_USERNAME="Tel_alum_bot"

# ==============================================================================
# Application & Domain URLs
# ==============================================================================

# APP_URL: The public HTTPS URL where this applet is hosted (e.g., Cloud Run service URL).
# Used for Telegram Mini App direct links, self-referential links, and payment webhook callbacks.
APP_URL="https://ais-pre-pgkcc4bmb4owcrsyh3umcr-408398640530.europe-west2.run.app"

# PORT: Port where the Node.js/Express server listens (default: 3000 in dev, 8080 in Cloud Run)
PORT=3000

# NODE_ENV: Application environment (development | production)
NODE_ENV="development"

# ==============================================================================
# Payment Gateway Webhooks & Keys
# ==============================================================================

# PAYSTACK_SECRET_KEY: Your Paystack Secret Key (MUST start with sk_live_ or sk_test_, NOT pk_live_)
# Used to verify HMAC-SHA512 webhook signatures from /api/webhooks/paystack and process automated wallet credits
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# PAYSTACK_PUBLIC_KEY: (Optional) Your Paystack Public Key (starts with pk_live_ or pk_test_)
# Used in client-side inline checkout if integrating direct browser popup
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# FLUTTERWAVE_SECRET_HASH: (Disabled for now)
# Flutterwave payment option is currently disabled. Not required for launch.
# FLUTTERWAVE_SECRET_HASH="your_flutterwave_secret_hash"

# ==============================================================================
# AI & Gemini API
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls (career advisor, profile polish, smart matchmaking).
# In AI Studio, this is automatically injected at runtime from project secrets.
GEMINI_API_KEY="AIzaSy..."

# ==============================================================================
# Database / PostgreSQL (Cloud SQL)
# ==============================================================================

# Note: In Google Cloud Run / AI Studio, Cloud SQL environment variables are
# automatically injected into the container via the Cloud SQL Unix socket proxy.
SQL_HOST="/app/cloudsql/hidef-atlas-r5v9p:europe-west2:ai-studio-0e7a2b0a"
SQL_DB_NAME="cloud_sql_development_database"
SQL_USER="ai_studio_app_user"
SQL_PASSWORD="your_cloud_sql_password"
SQL_ADMIN_USER="ai_studio_admin"
SQL_ADMIN_PASSWORD="your_cloud_sql_admin_password"

# Optional standard connection string format if using external PostgreSQL (e.g., Supabase / Neon / RDS)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
